{
    "scope": {
        "type": "string",
        "description": "应用范围",
        "options": ["only_chat_llm", "chat_and_plugin_llm"],
        "labels": ["仅普通聊天回复", "普通聊天与插件触发的回复"],
        "hint": "仅对所选范围的 LLM 回复执行净化、转图和假 @ 转换；指令和固定文本回复不处理。插件触发指其他插件通过 event.request_llm 发起的 LLM 回复",
        "default": "only_chat_llm"
    },
    "remove_thinking": {
        "type": "bool",
        "description": "移除思考过程",
        "hint": "过滤开头以英文为主的无标签思考段落",
        "default": false
    },
    "remove_markdown": {
        "type": "bool",
        "description": "净化 Markdown 格式",
        "hint": "移除粗体、标题、链接、列表标记等 Markdown 符号（仅对未触发转图的纯文本回复生效）",
        "default": true
    },
    "official_relay": {
        "type": "object",
        "description": "复杂格式交给官方机器人发送",
        "hint": "需要转图时，改由同群的 QQ 官方机器人（qq_official）在后台以原生 Markdown 主动发送，群里不需要 @ 它。要求群主已为官方机器人开启「机器人主动在群聊内发言」；发送失败时自动回退为转图。仅群聊生效",
        "items": {
            "enable": {
                "type": "bool",
                "description": "启用官方机器人代发",
                "hint": "要求官方机器人与本账号在同一个群，且两个平台都启用了本插件",
                "default": false
            },
            "bot_qq": {
                "type": "string",
                "description": "官方机器人的 QQ 号",
                "hint": "官方机器人在群成员列表里显示的 QQ 号（纯数字）。每个群第一次代发时，本账号会 @ 它并发送一条一次性口令来绑定该群，之后不再出现；已在下方手动映射的群不需要",
                "default": ""
            },
            "platform_id": {
                "type": "string",
                "description": "官方机器人的平台 ID",
                "hint": "AstrBot「机器人」页面里该官方机器人的 ID。留空时自动选择：绑定时响应口令的那个官方机器人，或第一个官方机器人平台。只有同时运行多个官方机器人时才需要填",
                "default": ""
            },
            "group_map": {
                "type": "list",
                "description": "手动群映射",
                "hint": "每项格式为 QQ群号:群openid，例如 123456789:A44E8413A363E09453BD414E320D3494。填写的群跳过口令绑定并以此为准。群 openid 可在官方机器人该群会话的 UMO 末尾找到",
                "default": []
            },
            "timeout": {
                "type": "int",
                "description": "绑定等待超时 (秒)",
                "hint": "发出绑定口令后等待官方机器人响应的时间，超时则转图，并在 5 分钟内不再对该群尝试。范围 3-60",
                "default": 10
            },
            "recall_trigger": {
                "type": "bool",
                "description": "撤回绑定口令",
                "hint": "绑定结束后撤回本账号发出的那条 @ 口令消息",
                "default": true
            }
        }
    },
    "t2i": {
        "type": "object",
        "description": "复杂格式整段转图",
        "hint": "检测到勾选的格式时，保留排版并通过 AstrBot 官方文转图流程整段渲染为图片发送",
        "items": {
            "enable": {
                "type": "bool",
                "description": "启用转图",
                "hint": "总开关，关闭后以下分类检测全部失效",
                "default": true
            },
            "formula": {
                "type": "bool",
                "description": "数学公式",
                "hint": "$$...$$、\\[...\\]、\\(...\\)、常见 LaTeX 命令、含命令或上下标的行内 $...$",
                "default": true
            },
            "table": {
                "type": "bool",
                "description": "表格",
                "hint": "Markdown 表格与 HTML <table>",
                "default": true
            },
            "code_block": {
                "type": "bool",
                "description": "多行代码块",
                "hint": "```...``` 围栏且内部含换行（单行行内代码不触发）",
                "default": true
            },
            "nested_list": {
                "type": "bool",
                "description": "多级嵌套列表",
                "hint": "存在缩进的子列表项（平级列表不触发）",
                "default": false
            },
            "image_type": {
                "type": "string",
                "description": "图片格式",
                "options": ["png", "jpeg"],
                "hint": "png 无损最清晰；jpeg 体积更小（配合下方质量参数）",
                "default": "png"
            },
            "quality": {
                "type": "int",
                "description": "JPEG 质量 (1-100)",
                "hint": "仅图片格式为 jpeg 时生效；框架默认仅 40，建议 85-95",
                "default": 90
            },
            "scale": {
                "type": "string",
                "description": "渲染缩放倍率",
                "options": ["normal", "high", "ultra"],
                "hint": "设备像素比：normal=1.0 / high=1.3 / ultra=1.8，越高文字越锐利、图片越大",
                "default": "ultra"
            },
            "viewport_width": {
                "type": "int",
                "description": "视口宽度 (px)",
                "hint": "渲染页面宽度，决定图片宽度与排版换行",
                "default": 1080
            },
            "viewport_height": {
                "type": "int",
                "description": "视口高度 (px)",
                "hint": "初始高度；实际按整页内容截图，一般无需调整",
                "default": 900
            }
        }
    }
}
